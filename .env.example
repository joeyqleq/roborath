# Never commit actual credentials; install on ORA3 as /etc/roborath.env, chmod 0600.
# New Twitch app: client type Confidential, redirect http://localhost:3000
# Bot is an ordinary Twitch viewer (not a moderator).
TWITCH_IRC_NICK=roborath
TWITCH_CHANNEL_LOGIN=rath_bone
TWITCH_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
TWITCH_CLIENT_SECRET=ROTATED_CLIENT_SECRET_NOT_IN_GIT
TWITCH_TOKEN_FILE=/var/lib/roborath/private/oauth.json
# These are TWITCH numeric user IDs, resolved via setup_cli.py, NOT usernames.
ROBORATH_OWNER_TWITCH_USER_ID=NUMERIC_JOEYLEQ_ID
ROBORATH_STREAMER_TWITCH_USER_ID=NUMERIC_RATH_BONE_ID
# Do not use the Mattermost sysadmin as the relay bot.
MATTERMOST_URL=https://matter.greenthumb.lol
MATTERMOST_BOT_TOKEN=RESTRICTED_RELAY_BOT_TOKEN
MATTERMOST_CHANNEL_ID=PRIVATE_RELAY_CHANNEL_ID
MM_FACTCHECK_USER_ID=d66mch8hwtrfzdj795wgctzxra
GT_TWITCH_DB=/var/lib/roborath/chat.sqlite3
GT_LOG_RETENTION_DAYS=30
GT_USER_COOLDOWN_SECONDS=8
GT_GLOBAL_REPLY_COOLDOWN_SECONDS=4

# Restrict all public Twitch replies to verified owner ID during testing.
ROBORATH_OWNER_ONLY_TEST_MODE=true
# When QA is false, retain grants-only preview unless public access is approved.
ROBORATH_PUBLIC_ACCESS_ENABLED=false

# Switch on only after restricted private agent gives a verified answer.
ROBORATH_FACT_RELAY_ENABLED=false

# Optional stable/private SearXNG origins. Never use an ephemeral container IP.
ROBORATH_SEARXNG_URLS=
# Deterministic routing avoids an extra local inference per chat turn.
ROBORATH_LOCAL_DECISION_ENABLED=false
# Pipeline model stays off until latency/accuracy beat the deterministic routes.
ROBORATH_PIPELINE_DECISION_ENABLED=false
ROBORATH_DECISION_MODEL=tev1:0.8b
# If enabled later, use a verified private Ollama origin hosting that model.
ROBORATH_DECISION_BASE_URL=http://127.0.0.1:11434
# Local direct-model budget ceilings in estimated USD; provider billing is authoritative.
ROBORATH_DAILY_MODEL_USD=1.00
ROBORATH_STREAM_MODEL_USD=0.25
# Hard dispatch ceilings for the private agent; its internal billed chain is separate.
ROBORATH_RELAY_DAILY_REQUESTS=20
ROBORATH_RELAY_STREAM_REQUESTS=10

# Explicitly owner-granted testers may invoke during otherwise owner-only QA.
ROBORATH_QA_GRANTED_TESTERS=false
